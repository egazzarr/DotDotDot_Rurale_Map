{
  "version": 8,
  "name": "Italy Exhibition Style (merged)",
  "metadata": {"maputnik:renderer": "mlgljs"},
  "terrain": {"source": "terrainSource", "exaggeration": 2},
  "sources": {
    "terrainSource": {
      "type": "raster-dem",
      "url": "pmtiles://../../tests/Test2-Maps_Rurale_Test/0.local3Dmap/local_map_height/planet_italy_height.pmtiles",
      "encoding": "terrarium", 
      "tileSize": 512
    },
    "hillshadeSource": {
      "type": "raster-dem",
      "url": "pmtiles://../../tests/Test2-Maps_Rurale_Test/0.local3Dmap/local_map_height/planet_italy_height.pmtiles",
      "encoding": "terrarium", 
      "tileSize": 512
    },
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://../../tests/Test2-Maps_Rurale_Test/0.local3Dmap/local_map_tiles/it_flat.pmtiles"
    }
  },
  
  "layers": [
    {
      "id": "baseColor",
      "type": "background",
      "paint": {"background-color": "rgba(44, 42, 41, 1)"}
    },
    {
      "id": "landcover_ice_shelf",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "maxzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "subclass"], "ice_shelf"]
      ],
      "layout": {"visibility": "none"},
      "paint": {"fill-color": "hsl(0,0%,98%)", "fill-opacity": 0.7}
    },
    {
      "id": "landcover_glacier",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "maxzoom": 8,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "subclass"], "glacier"]
      ],
      "layout": {"visibility": "none"},
      "paint": {
        "fill-color": "hsl(0,0%,98%)",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 0, 1, 8, 0.5]
      }
    },
    {
      "id": "landcover_wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 10,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "class"], "wood"]
      ],
      "layout": {"visibility": "visible"},
      "paint": {
        "fill-color": "rgba(85, 81, 79, 1)",
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 8, 0, 12, 0.6]
      }
    },
    {
      "id": "landuse_residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "maxzoom": 16,
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["==", ["get", "class"], "residential"]
      ],
      "layout": {"visibility": "visible"},
      "paint": {
        "fill-color": "rgba(44, 42, 41, 1)",
        "fill-opacity": [
          "interpolate",
          ["exponential", 0.6],
          ["zoom"],
          8,
          0.8,
          9,
          0.6
        ],
        "fill-antialias": false
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "minzoom": 0,
      "maxzoom": 24,
      "filter": [
        "match",
        ["geometry-type"],
        ["MultiPolygon", "Polygon"],
        true,
        false
      ],
      "layout": {"visibility": "none"},
      "paint": {"fill-color": "rgba(38, 48, 32, 1)"}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "all",
        ["match", ["geometry-type"], ["MultiPolygon", "Polygon"], true, false],
        ["!=", ["get", "brunnel"], "tunnel"]
      ],
      "paint": {"fill-antialias": true, "fill-color": "rgba(120, 115, 112, 1)"}
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "filter": [
        "match",
        ["geometry-type"],
        ["LineString", "MultiLineString"],
        true,
        false
      ],
      "paint": {"line-color": "rgba(120, 115, 112, 1)", "line-width": 1}
    },
    {
      "id": "hills",
      "type": "hillshade",
      "source": "hillshadeSource",
      "layout": {"visibility": "visible"},
      "paint": {
        "hillshade-shadow-color": ["rgba(120, 115, 112, 1)"],
        "hillshade-highlight-color": ["rgba(74, 71, 69, 1)"],
        "hillshade-exaggeration": 0.5,
        "hillshade-accent-color": "rgba(133, 133, 133, 1)"
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 0,
      "maxzoom": 24,
      "paint": {
        "fill-antialias": true,
        "fill-color": "rgba(234, 192, 192, 0.62)",
        "fill-outline-color": "rgba(234, 192, 192, 0)"
      }
    },
    {
      "id": "highway_minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["match", ["get", "class"], ["minor", "service", "track"], true, false]
      ],
      "layout": {"visibility": "none"},
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.9,
        "line-width": [
          "interpolate",
          ["exponential", 1.55],
          ["zoom"],
          13,
          1.8,
          20,
          20
        ]
      }
    },
    {
      "id": "highway_major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 1,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        [
          "match",
          ["get", "class"],
          ["primary", "secondary", "tertiary", "trunk"],
          true,
          false
        ]
      ],
      "layout": {"visibility": "none"},
      "paint": {
        "line-color": "#f2b56b",
        "line-width": [
          "interpolate",
          ["exponential", 1.3],
          ["zoom"],
          10,
          2,
          20,
          20
        ],
        "line-opacity": 0
      }
    },
    {
      "id": "highway_motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "maxzoom": 24,
      "filter": [
        "all",
        [
          "match",
          ["geometry-type"],
          ["LineString", "MultiLineString"],
          true,
          false
        ],
        ["==", ["get", "class"], "motorway"]
      ],
      "layout": {"visibility": "none"},
      "paint": {
        "line-color": "#e58a3f",
        "line-width": [
          "interpolate",
          ["exponential", 1],
          ["zoom"],
          4,
          1.3,
          20,
          30
        ],
        "line-opacity": 0
      }
    }
  ],
  "id": "z4cqfs4"
}